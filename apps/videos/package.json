{
  "name": "@motionvideo/videos",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "mkdir -p public/fonts && cp -R ../web/public/fonts/timeless public/fonts/",
    "prestudio": "pnpm fonts",
    "studio": "remotion studio",
    "typecheck": "node scripts/typecheck.mjs",
    "launch:render": "pnpm fonts && remotion render MotionVideoLaunch out/picture.mp4 --scale=1.5 --crf=16 --muted",
    "launch:audio:cues": "node --experimental-strip-types --no-warnings audio/write-cues.ts",
    "launch:audio:forge": "${EARSHOT:-$HOME/.local/share/earshot}/.venv/bin/python audio/forge_sfx.py",
    "launch:audio:mix": "${EARSHOT:-$HOME/.local/share/earshot}/.venv/bin/python -I ${EARSHOT:-$HOME/.local/share/earshot}/skills/real-sound/scripts/mix.py --root . --design audio/sounddesign.json --trace out/qa/adds.json",
    "launch:audio:mux": "node ${EARSHOT:-$HOME/.local/share/earshot}/skills/real-sound/scripts/mux.mjs --video out/picture.mp4 --audio out/audio/soundtrack.wav --out out/motionvideo-launch.mp4",
    "launch:build": "pnpm launch:render && pnpm launch:audio:cues && pnpm launch:audio:mix && pnpm launch:audio:mux"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/tailwind-v4": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "culori": "^4.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^19",
    "typescript": "^5.9"
  }
}
