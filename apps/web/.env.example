# Copy to `.env` for local development (`cp .env.example .env`).
# In production, set secrets with `pnpm wrangler secret put <NAME>`.

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Leave empty in development to print emails to the dev server console.
RESEND_API_KEY=
EMAIL_FROM='"Aniket @ MotionVideo" <hello@motionvideo.xyz>'
# Comma-separated account emails allowed into /admin (submission and sponsor
# review). Production value lives in wrangler.jsonc vars.
ADMIN_EMAILS=

# Dodo Payments (merchant of record). Local development uses test mode; the
# live values are set in wrangler.jsonc vars and as Worker secrets.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Test-mode API key (Dodo dashboard → Developer → API Keys).
DODO_PAYMENTS_API_KEY=
# Live-mode API key, read only by `pnpm dodo:setup --live`.
DODO_PAYMENTS_LIVE_API_KEY=
# Written by `pnpm dodo:setup` (test mode). The setup script generates a local
# webhook key when no test endpoint is registered, so signed sample events
# can be sent to /api/webhook/dodo.
# Retired Skill Bundle: no longer sold; identifies its buyers.
DODO_PRODUCT_SKILL=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_PRO_LIFETIME=
DODO_PRODUCT_BUSINESS_MONTHLY=
DODO_PRODUCT_BUSINESS_ANNUAL=
DODO_PRODUCT_SPONSOR_DIAMOND=
DODO_PRODUCT_SPONSOR_GOLD=
DODO_PRODUCT_SPONSOR_SILVER=
DODO_PRODUCT_SPONSOR_DIAMOND_ONCE=
DODO_PRODUCT_SPONSOR_GOLD_ONCE=
DODO_PRODUCT_SPONSOR_SILVER_ONCE=
DODO_PRODUCT_JOB_STANDARD=
DODO_PRODUCT_JOB_FEATURED=
DODO_PAYMENTS_WEBHOOK_KEY=

# PostHog product analytics (public, build-time). Leave empty to disable.
# Put the key in .env.production so only builds (not `pnpm dev`) send events.
# EU projects: VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Public origin of the uploads bucket; empty serves uploads via the Worker.
UPLOADS_PUBLIC_URL=

# Cloudflare Turnstile secret for the sign-in code endpoint (wrangler secret in
# production). Empty disables the check. Test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Google sign-in (OAuth web client from Google Cloud); both are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog personal API key with the `query:read` scope (wrangler secret in
# production). Feeds the traffic numbers on /sponsor; empty hides them.
POSTHOG_PERSONAL_API_KEY=
