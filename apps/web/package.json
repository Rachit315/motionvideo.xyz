{
  "name": "@motionvideo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "predev": "node scripts/pull-fonts.mjs",
    "build": "vite build",
    "prebuild": "node scripts/pull-fonts.mjs",
    "postinstall": "fumadocs-mdx",
    "postbuild": "node scripts/link-root-deploy-config.mjs",
    "fonts:pull": "node scripts/pull-fonts.mjs",
    "dodo:setup": "node scripts/setup-dodo.mjs",
    "moves:check": "node scripts/check-moves.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "typecheck": "intlayer build && wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "auth:schema": "pnpm dlx auth@latest generate --config scripts/auth-schema.config.ts --output src/server/db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "email:dev": "email dev --dir src/emails --port 3001",
    "assets:mirror": "node scripts/mirror-assets.mjs",
    "catalog:discover": "node scripts/discover-x-posts.mjs",
    "catalog:duplicates": "node scripts/find-duplicates.mjs",
    "catalog:import:articles": "node scripts/import-x-articles.mjs",
    "catalog:import:videos": "node scripts/import-x-videos.mjs",
    "catalog:remove": "node scripts/remove-videos.mjs",
    "catalog:refresh:colors": "node scripts/refresh-colors.mjs",
    "catalog:refresh:skills": "node scripts/refresh-skill-stats.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@web-kits/audio": "^0.2.0",
    "better-auth": "^1.7.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "dodopayments": "^2.54.1",
    "drizzle-orm": "^0.45.3",
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "input-otp": "^1.5.0",
    "intlayer": "^9.7.0",
    "motion": "^14.1.0",
    "player.style": "^0.3.4",
    "posthog-js": "^1.438.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.11.0",
    "react-intlayer": "^9.7.0",
    "recharts": "^3.10.1",
    "reicon-react": "^1.2.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@react-email/ui": "^6.11.0",
    "@shadcn/lint": "^0.2.0",
    "@tanstack/devtools-vite": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cf": "1.0.0-beta.17",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6",
    "vite": "^8",
    "vite-intlayer": "^9.7.0",
    "wrangler": "^4.142.0"
  }
}
