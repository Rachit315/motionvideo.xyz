# Copy to `.env` for local development (`cp .env.example .env`).
# In production, set secrets with `pnpm wrangler secret put <NAME>`.

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Leave empty in development to print emails to the dev server console.
RESEND_API_KEY=
EMAIL_FROM='"Aniket @ MotionVideo" <hello@motionvideo.xyz>'
# Comma-separated account emails allowed into /admin (submission and sponsor
# review). Production value lives in wrangler.jsonc vars.
ADMIN_EMAILS=

# Dodo Payments (merchant of record). Local development uses test mode; the
# live values are set in wrangler.jsonc vars and as Worker secrets.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Test-mode API key (Dodo dashboard → Developer → API Keys).
DODO_PAYMENTS_API_KEY=
# Live-mode API key, read only by `pnpm dodo:setup --live`.
DODO_PAYMENTS_LIVE_API_KEY=
# Written by `pnpm dodo:setup` (test mode). The setup script generates a local
# webhook key when no test endpoint is registered, so signed sample events
# can be sent to /api/webhook/dodo.
DODO_PRODUCT_SKILL=
DODO_PRODUCT_SPONSOR_DIAMOND=
DODO_PRODUCT_SPONSOR_GOLD=
DODO_PRODUCT_SPONSOR_SILVER=
# $20 off the skill bundle, usage_limit=100. Keep its ID stable: recreating it
# resets the launch offer's sold count.
DODO_LAUNCH_DISCOUNT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
