{
  "name": "motionvideo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @motionvideo/web run dev",
    "build": "pnpm --filter @motionvideo/web run build",
    "deploy": "pnpm --filter @motionvideo/web run deploy",
    "assets:mirror": "pnpm --filter @motionvideo/web run assets:mirror",
    "studio": "pnpm --filter @motionvideo/videos run studio",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6",
    "ultracite": "7.12.1"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/oauth-provider": "1.7.6"
    }
  }
}
