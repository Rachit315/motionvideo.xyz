{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motionvideo",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  // Prerendered content pages (STATIC_PAGES in src/constants/routes.ts) run the
  // Worker first so it can apply the www redirect, then it serves the static
  // HTML through ASSETS. Scripts, styles, and images skip the Worker.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/about",
      "/brand",
      "/contact",
      "/license",
      "/privacy",
      "/refunds",
      "/terms",
    ],
  },
  // Production stays on the custom domains; PR Previews use workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "motionvideo.xyz", "custom_domain": true },
    { "pattern": "www.motionvideo.xyz", "custom_domain": true },
  ],
  // Non-secret production config. `.env` overrides these locally with test-mode
  // values. `pnpm dodo:setup --live` writes the live Dodo IDs below.
  // Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, DODO_PAYMENTS_API_KEY,
  // DODO_PAYMENTS_WEBHOOK_KEY) are set with `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_URL": "https://motionvideo.xyz",
    "EMAIL_FROM": "\"Aniket @ MotionVideo\" <hello@motionvideo.xyz>",
    "ADMIN_EMAILS": "hello@motionvideo.xyz,pawaraniket508@gmail.com",
    "DODO_PAYMENTS_ENVIRONMENT": "live_mode",
    "DODO_PRODUCT_SKILL": "pdt_0NpNXaPWFYUJrFMSsud2d",
    "DODO_PRODUCT_SPONSOR_DIAMOND": "pdt_0NpNXaRMKrltVcSg5Fp4u",
    "DODO_PRODUCT_SPONSOR_GOLD": "pdt_0NpNXaSJzUiH9v10l0QNb",
    "DODO_PRODUCT_SPONSOR_SILVER": "pdt_0NpNXaTf7ZtRfRYuqmg9v",
    // One 30-day run per tier; set by `pnpm dodo:setup --live`.
    "DODO_PRODUCT_SPONSOR_DIAMOND_ONCE": "",
    "DODO_PRODUCT_SPONSOR_GOLD_ONCE": "",
    "DODO_PRODUCT_SPONSOR_SILVER_ONCE": "",
    "DODO_PRODUCT_JOB_STANDARD": "pdt_0Npn9szB8Z5kqnx2MBPVg",
    "DODO_PRODUCT_JOB_FEATURED": "pdt_0Npn9szIfRBwgezuI25bw",
    "DODO_LAUNCH_DISCOUNT_ID": "dsc_0NpNXaUrA1aatsq1xXVwH",
    // Uploads are linked from the bucket's public domain (cached at the edge,
    // no Worker request per view). Empty: served by the Worker at /uploads/.
    "UPLOADS_PUBLIC_URL": "https://assets.motionvideo.xyz",
  },
  // Contact form: 3 messages per minute per IP.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    // Image uploads: 10 per minute per IP (storage and R2 writes).
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Live presence (online count and cursors): one Durable Object instance
  // holds every visitor's WebSocket (src/server/presence.ts).
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }],
  // Logos and covers uploaded on /jobs/post and /sponsorships, under the
  // `uploads/` prefix of the media bucket, served by the Worker at /uploads/.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "motionvideo-assets" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motionvideo",
      "database_id": "c44471e8-d7d2-4005-8f95-1e12f0ee0ae8",
      "migrations_dir": "drizzle",
    },
  ],
  // Shared staging resources, never production bindings or live payments.
  "previews": {
    "vars": {
      "BETTER_AUTH_URL": "https://feat-motionvideo-v2-motionvideo.pawaraniket508.workers.dev",
      "EMAIL_FROM": "\"MotionVideo Preview\" <hello@motionvideo.xyz>",
      "ADMIN_EMAILS": "hello@motionvideo.xyz,pawaraniket508@gmail.com",
      "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
      "DODO_PRODUCT_SKILL": "pdt_0NpNXXE9rdItzg65RmPaw",
      "DODO_PRODUCT_SPONSOR_DIAMOND": "pdt_0Npnyoo6FbtrcV9op2rYL",
      "DODO_PRODUCT_SPONSOR_GOLD": "pdt_0NpnyontPpuk06PKMlstF",
      "DODO_PRODUCT_SPONSOR_SILVER": "pdt_0Npnyom7sPqPQTNFXp8mS",
      "DODO_PRODUCT_SPONSOR_DIAMOND_ONCE": "pdt_0NpnyokyqhN3yRV1bOw7C",
      "DODO_PRODUCT_SPONSOR_GOLD_ONCE": "pdt_0Npnyom7rBHT1iGGFGJpX",
      "DODO_PRODUCT_SPONSOR_SILVER_ONCE": "pdt_0Npnyojv6m33RUQt1kpdl",
      "DODO_PRODUCT_JOB_STANDARD": "pdt_0Npm8wZZC70CtLPJI3lSL",
      "DODO_PRODUCT_JOB_FEATURED": "pdt_0Npm8wx91Hhgl33rDpqUH",
      "DODO_LAUNCH_DISCOUNT_ID": "dsc_0NpNXXKp7dDOvjem1ATIH",
      "UPLOADS_PUBLIC_URL": "",
    },
    "ratelimits": [
      {
        "name": "CONTACT_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 3, "period": 60 },
      },
      {
        "name": "UPLOAD_LIMITER",
        "namespace_id": "1004",
        "simple": { "limit": 10, "period": 60 },
      },
    ],
    "durable_objects": {
      "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }],
    },
    // Create once: `wrangler r2 bucket create motionvideo-assets-preview`.
    "r2_buckets": [
      { "binding": "UPLOADS", "bucket_name": "motionvideo-assets-preview" },
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "motionvideo-preview",
        "database_id": "f29e4238-a5d6-43ae-8f5d-63dcc9694bea",
        "migrations_dir": "drizzle",
      },
    ],
  },
  // D1 migration commands select named environments, not the previews block.
  "env": {
    "preview": {
      "routes": [],
      // Same limiters as `previews`; declared so the binding types stay required.
      "ratelimits": [
        {
          "name": "CONTACT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 3, "period": 60 },
        },
        {
          "name": "UPLOAD_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }],
      },
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "motionvideo-assets-preview" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motionvideo-preview",
          "database_id": "f29e4238-a5d6-43ae-8f5d-63dcc9694bea",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
}
